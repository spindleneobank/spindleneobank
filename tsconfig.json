{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": { "@spindle/shared/*": ["./src/shared/*"] }
  },
  "include": ["src", "dev", "drizzle.config.ts"],
  "exclude": ["static", "web", "node", "contracts", "node_modules"]
}
