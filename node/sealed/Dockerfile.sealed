# syntax=docker/dockerfile:1.7
# Spindle sealed-lane node image (runs inside a dstack Intel TDX confidential VM with NVIDIA CC mode).
# UNBUILT / UNVERIFIED ON HARDWARE: not built in the development environment (needs the vLLM base image + a GPU host).
# amd64 only. Build context: the app/ root.  docker build -f node/sealed/Dockerfile.sealed .
#
# Same agent + vLLM as node/docker/Dockerfile.vllm, plus:
#   - nvTrust local GPU verifier + nv-attestation-sdk (evidence for NRAS)
#   - SPINDLE_SEALED=1 (the agent generates the HPKE key in-CVM and attaches the attestation bundle)
# After building, push by DIGEST and put that digest in app-compose.json: the dstack compose hash (measured into
# RTMR3) then pins exactly this image.

FROM --platform=linux/amd64 oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS build
WORKDIR /app
COPY package.json bun.lock ./
COPY node/package.json node/package.json
COPY web/package.json web/package.json
RUN bun install --frozen-lockfile
COPY src/shared src/shared
COPY node/src node/src
COPY node/tsconfig.json node/tsconfig.json
WORKDIR /app/node
RUN bun build src/main.ts --compile --minify --target=bun-linux-x64 --outfile /out/spindle-node

# vllm-openai v0.11.0 (same pin as docker/Dockerfile.vllm)
FROM --platform=linux/amd64 vllm/vllm-openai:v0.11.0@sha256:014a95f21c9edf6abe0aea6b07353f96baa4ec291c427bb1176dc7c93a85845c
# Pin both versions when first building on the tester's host and record them in docs/plan/sealed-testing.md.
ARG NV_ATTESTATION_SDK_VERSION
ARG NVTRUST_REF
RUN test -n "$NV_ATTESTATION_SDK_VERSION" && test -n "$NVTRUST_REF" \
 && pip install --no-cache-dir "nv-attestation-sdk==${NV_ATTESTATION_SDK_VERSION}" "git+https://github.com/NVIDIA/nvtrust.git@${NVTRUST_REF}#subdirectory=guest_tools/attestation_sdk" \
 && pip install --no-cache-dir "git+https://github.com/NVIDIA/nvtrust.git@${NVTRUST_REF}#subdirectory=guest_tools/gpu_verifiers/local_gpu_verifier"
COPY --from=build /out/spindle-node /usr/local/bin/spindle-node
COPY node/docker/entrypoint.sh /usr/local/bin/spindle-entrypoint
COPY node/sealed/collect_gpu_evidence.py /opt/spindle/collect_gpu_evidence.py
RUN chmod 0755 /usr/local/bin/spindle-node /usr/local/bin/spindle-entrypoint && mkdir -p /data/hf
ENV SPINDLE_DATA_DIR=/data \
    SPINDLE_ENGINE=vllm \
    SPINDLE_SEALED=1 \
    HF_HOME=/data/hf \
    SPINDLE_VLLM_GPU_UTIL=0.90
VOLUME /data
HEALTHCHECK --interval=30s --timeout=5s --start-period=900s --retries=3 \
  CMD test -f /tmp/spindle-ready || exit 1
ENTRYPOINT ["/usr/local/bin/spindle-entrypoint"]
