{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": { "includes": ["**", "!static/**", "!contracts/lib/**", "!**/dist/**", "!drizzle/**", "!contracts/out/**", "!contracts/cache/**"] },
