# Build context for docs/deploy/backend.Dockerfile (dev compose and prod release). Keep the lockfile
# manifests (workspaces), src, drizzle, dev, contracts/gas and contracts/deployments.
**/node_modules
.git
.worktrees
data
*.log
.env*
.playwright-cli
# frontend sources are not part of the backend image (only its package.json is needed)
web/*
!web/package.json
# node agent: the backend image builds the served node distribution from these (Dockerfile node-dist stage)
node/*
!node/package.json
!node/tsconfig.json
!node/src
!node/docker
!node/install.sh
!node/install.ps1
# foundry project: only the gas table and deployment records are read at runtime
contracts/lib
contracts/out
contracts/cache
contracts/broadcast
contracts/src
contracts/test
contracts/script
contracts/docs
contracts/deployments/*-fork.json
